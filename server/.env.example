# WhatsApp CRM - server configuration (free/AI defaults)
PORT=4000
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string

# Super admin account (created on first boot)
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=admin123

# Default AI provider for new companies.
#   ollama  -> free local AI, no key needed (install ollama.com -> ollama pull llama3.2)
#   groq    -> free API key at console.groq.com
#   openai  -> paid
#   none    -> AI disabled until configured per company
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2
AI_API_KEY=
TTS_VOICE=en-US-JennyNeural

# Optional ElevenLabs voice provider. The default Edge provider is free.
# Create a free account at elevenlabs.io, then set these values to use it.
# Set to elevenlabs to use ElevenLabs for AI replies, human voice replies,
# and voice campaigns. Keep the API key in the server environment only.
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
# ElevenLabs voice ID, for example: 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID=
